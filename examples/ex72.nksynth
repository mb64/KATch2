// ===================================================================
// Tour network (5 nodes).  Field encoding (KATch2 x[lo..hi] ranges):
//   x[0..3]  loc : G=0 S=1 M=2 W=3 I=4
//   x[3..6]  pt  : port number (1..4)
//   x[6..7]  dst : M=0 W=1
//   x[7..8]  typ : ftp=0 web=1
//   x[8..9]  src : W=1 else 0   (Example 6 only)
// Bidirectional links: G:2<->S:1, S:2<->M:1, S:3<->W:1, S:4<->I:1
// ===================================================================

hole h

def topo =
    (x[0..3]~0; x[3..6]~2; x[0..3]:=1; x[3..6]:=1)   // G:2 -> S:1
  + (x[0..3]~1; x[3..6]~1; x[0..3]:=0; x[3..6]:=2)   // S:1 -> G:2
  + (x[0..3]~1; x[3..6]~2; x[0..3]:=2; x[3..6]:=1)   // S:2 -> M:1
  + (x[0..3]~2; x[3..6]~1; x[0..3]:=1; x[3..6]:=2)   // M:1 -> S:2
  + (x[0..3]~1; x[3..6]~3; x[0..3]:=3; x[3..6]:=1)   // S:3 -> W:1
  + (x[0..3]~3; x[3..6]~1; x[0..3]:=1; x[3..6]:=3)   // W:1 -> S:3
  + (x[0..3]~1; x[3..6]~4; x[0..3]:=4; x[3..6]:=1)   // S:4 -> I:1
  + (x[0..3]~4; x[3..6]~1; x[0..3]:=1; x[3..6]:=4)   // I:1 -> S:4

def inp  = x[0..3]~0; x[3..6]~1
def outp = x[0..3]~2 + x[0..3]~3

def mask = 1
// def mask = !x[0..3]~2 + !x[7..8]~0
def base = x[0..3]~1; (x[6..7]~0; x[3..6]:=2 + x[6..7]~1; x[3..6]:=3)

def pol = (x[0..3]~0; x[3..6]:=2) + (x[0..3]~4; x[3..6]:=1) + (x[0..3]~1; h)
def net = inp; (pol; topo)*; outp

def polBase = (x[0..3]~0; x[3..6]:=2) + (x[0..3]~4; x[3..6]:=1) + (x[0..3]~1; base)
def netBase = inp; (polBase; topo)*; outp

assert net = (netBase; mask)

