hole = skip
hop = hole; pol; topo
net = (hop; dup)*

check loc=Syd; dst=PNR; net; loc=PNR == drop
check loc=HLT; dst=CHC; net; loc=CHC == drop

check (loc=CHC; port=0; out=0; dst=MUP; loc:=WLG; port:=4 ; dup; loc:=AVL; port:=1 ; dup; loc:=MUP; port:=1 ) <= hop; dup; hop; dup; hop
check (loc=NSH; port=0; out=0; dst=POR; loc:=AKL; port:=4 ; dup; loc:=PNR; port:=2 ; dup; loc:=WLG; port:=3 ; dup; loc:=AVL; port:=1 ; dup; loc:=POR; port:=1 ) <= hop; dup; hop; dup; hop; dup; hop; dup; hop
check (loc=POR; port=0; out=0; dst=IVM; loc:=AVL; port:=2 ; dup; loc:=WLG; port:=2 ; dup; loc:=DUD; port:=1 ; dup; loc:=IVM; port:=1 ) <= hop; dup; hop; dup; hop; dup; hop
