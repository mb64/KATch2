    (x0=0; x1=0; x2=1; x3=0; x4=1; x13=0; x5=0; x6=1; x7=1; x8=0; x9=0; x10:=0; x11:=1; x12:=0; x13:=1)
 +
    (x0=0; x1=0; x2=1; x3=0; x4=1; x13=0; x5=0; x6=1; x7=1; x8=0; x9=1; x10:=0; x11:=1; x12:=0; x13:=1)
 +
    (x0=0; x1=0; x2=1; x3=0; x4=1; x13=0; x5=0; x6=1; x7=0; x8=0; x9=0; x10:=0; x11:=1; x12:=0; x13:=1)
 +
    (x0=0; x1=0; x2=1; x3=0; x4=1; x13=0; x5=0; x6=0; x7=0; x8=0; x9=1; x10:=0; x11:=1; x12:=0; x13:=1)
 +
    (x0=0; x1=0; x2=1; x3=0; x4=1; x13=0; x5=0; x6=0; x7=1; x8=0; x9=0; x10:=0; x11:=1; x12:=0; x13:=1)

hole h1
def hop = h1; pol; topo
def net = (hop; dup)*

// BLOCK BAD PATHS
// Brisbane1 -> Sydney1 -> Sydney2 -> Melbourne2 -> Adelaide2
assert x0=0; x1=0; x2=1; x3=1; x4=1; x5=0; x6=1; x7=1; x8=1; x9=1; net; x0=0; x1=1; x2=1; x3=1; x4=1 = 0

// ALLOW GOOD PATHS
// Adelaide1 -> Melbourne1 -> Canberra1 -> Canberra2
assert (x0=0; x1=1; x2=1; x3=1; x4=0; x10=0; x11=0; x12=0; x13=0; x5=0; x6=1; x7=0; x8=1; x9=1; x0:=1; x1:=0; x2:=0; x3:=0; x4:=0; x10:=0; x11:=1; x12:=1 ; dup; x0:=0; x1:=0; x2:=0; x3:=1; x4:=1; x10:=0; x11:=1; x12:=0 ; dup; x0:=0; x1:=1; x2:=0; x3:=1; x4:=1; x10:=0; x11:=1; x12:=0 ) <= hop; dup; hop; dup; hop

// Perth1 -> Perth2 -> Adelaide2 -> Melbourne2 -> Sydney2 -> Sydney1 -> Brisbane1
assert (x0=0; x1=1; x2=1; x3=0; x4=0; x10=0; x11=0; x12=0; x13=0; x5=0; x6=0; x7=1; x8=1; x9=1; x0:=0; x1:=1; x2:=1; x3:=0; x4:=1; x10:=0; x11:=0; x12:=1 ; dup; x0:=0; x1:=1; x2:=1; x3:=1; x4:=1; x10:=0; x11:=0; x12:=1 ; dup; x0:=1; x1:=0; x2:=0; x3:=0; x4:=1; x10:=0; x11:=1; x12:=1 ; dup; x0:=0; x1:=0; x2:=1; x3:=0; x4:=0; x10:=1; x11:=0; x12:=0 ; dup; x0:=0; x1:=0; x2:=0; x3:=0; x4:=1; x10:=0; x11:=1; x12:=0 ; dup; x0:=0; x1:=0; x2:=1; x3:=1; x4:=1; x10:=0; x11:=0; x12:=1 ) <= hop; dup; hop; dup; hop; dup; hop; dup; hop; dup; hop

// Canberra1 -> Melbourne1 -> Adelaide1 -> Adelaide2
assert (x0=0; x1=0; x2=0; x3=1; x4=1; x10=0; x11=0; x12=0; x13=0; x5=0; x6=1; x7=1; x8=1; x9=1; x0:=1; x1:=0; x2:=0; x3:=0; x4:=0; x10:=0; x11:=0; x12:=1 ; dup; x0:=0; x1:=1; x2:=1; x3:=1; x4:=0; x10:=1; x11:=0; x12:=0 ; dup; x0:=0; x1:=1; x2:=1; x3:=1; x4:=1; x10:=0; x11:=1; x12:=0 ) <= hop; dup; hop; dup; hop
