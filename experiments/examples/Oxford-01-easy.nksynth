// Manchester -> Boston -> Framingham -> Worcester
assert x0=1; x1=1; x2=1; x3=0; x4=0; x5=1; x6=0; x7=0; x8=1; x9=0; net; x0=1; x1=0; x2=0; x3=1; x4=0 = 0
// Standish -> Portland -> Lewiston -> Augusta
assert x0=0; x1=0; x2=0; x3=0; x4=1; x5=0; x6=0; x7=1; x8=0; x9=1; net; x0=0; x1=0; x2=1; x3=0; x4=1 = 0

// ALLOW GOOD PATHS

// Norway -> Buckfield
assert (x0=1; x1=1; x2=1; x3=1; x4=0; x10=0; x11=0; x12=0; x13=0; x5=1; x6=0; x7=0; x8=0; x9=1; x0:=1; x1:=0; x2:=0; x3:=0; x4:=1; x10:=1; x11:=0; x12:=0 ) <= hop
// Sanford -> Portsmouth -> Portland -> Lewiston -> Augusta -> Turner
assert (x0=0; x1=0; x2=1; x3=0; x4=0; x10=0; x11=0; x12=0; x13=0; x5=1; x6=0; x7=1; x8=1; x9=0; x0:=1; x1:=0; x2:=0; x3:=0; x4:=0; x10:=0; x11:=1; x12:=0 ; dup; x0:=0; x1:=0; x2:=1; x3:=1; x4:=0; x10:=1; x11:=0; x12:=0 ; dup; x0:=1; x1:=1; x2:=0; x3:=0; x4:=1; x10:=0; x11:=1; x12:=0 ; dup; x0:=0; x1:=1; x2:=0; x3:=0; x4:=1; x10:=1; x11:=1; x12:=0 ; dup; x0:=1; x1:=0; x2:=1; x3:=1; x4:=0; x10:=1; x11:=0; x12:=0 ) <= hop; dup; hop; dup; hop; dup; hop; dup; hop
