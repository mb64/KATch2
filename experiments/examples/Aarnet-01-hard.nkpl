-- NOTE: solution is ~(loc=Brisbane1 & dst=Adelaide2)
hole = skip
hop = hole; pol; topo
net = (hop; dup)*

-- BLOCK BAD PATHS
-- [Red]: Brisbane1 -> Sydney1 -> Sydney2 -> Melbourne2 -> Adelaide2
check loc=Brisbane1; dst=Adelaide2; net; loc=Adelaide2 == drop

-- ALLOW GOOD PATHS
-- [Green]: Adelaide1 -> Melbourne1 -> Canberra1 -> Canberra2
check (loc=Adelaide1; port=0; out=0; dst=Canberra2; loc:=Melbourne1; port:=3 ; dup; loc:=Canberra1; port:=2 ; dup; loc:=Canberra2; port:=2 ) <= hop; dup; hop; dup; hop

-- [Blue]: Perth1 -> Perth2 -> Adelaide2 -> Melbourne2 -> Sydney2 -> Sydney1 -> Brisbane1
check (loc=Perth1; port=0; out=0; dst=Brisbane1; loc:=Perth2; port:=1 ; dup; loc:=Adelaide2; port:=1 ; dup; loc:=Melbourne2; port:=3 ; dup; loc:=Sydney2; port:=4 ; dup; loc:=Sydney1; port:=2 ; dup; loc:=Brisbane1; port:=1 ) <= hop; dup; hop; dup; hop; dup; hop; dup; hop; dup; hop

-- [Orange]: Canberra1 -> Melbourne1 -> Adelaide1 -> Adelaide2
check (loc=Canberra1; port=0; out=0; dst=Adelaide2; loc:=Melbourne1; port:=1 ; dup; loc:=Adelaide1; port:=4 ; dup; loc:=Adelaide2; port:=2 ) <= hop; dup; hop; dup; hop


