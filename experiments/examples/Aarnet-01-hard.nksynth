// NOTE: solution is (!x[0..5]~7 + !x[5..10]~15)
hole h1
def hop = h1; pol; topo
def net = (hop; dup)*

// BLOCK BAD PATHS
// [Red]: Brisbane1 -> Sydney1 -> Sydney2 -> Melbourne2 -> Adelaide2
assert x[0..5]~7; x[5..10]~15; net; x[0..5]~15 = 0

// ALLOW GOOD PATHS

// [Green]: Adelaide1 -> Melbourne1 -> Canberra1 -> Canberra2
assert (x[0..5]~14; x[10..13]~0; x[13..14]~0; x[5..10]~11; x[0..5]:=16; x[10..13]:=3 ; dup; x[0..5]:=3; x[10..13]:=2 ; dup; x[0..5]:=11; x[10..13]:=2 ) <= hop; dup; hop; dup; hop

// [Blue]: Perth1 -> Perth2 -> Adelaide2 -> Melbourne2 -> Sydney2 -> Sydney1 -> Brisbane1
assert (x[0..5]~12; x[10..13]~0; x[13..14]~0; x[5..10]~7; x[0..5]:=13; x[10..13]:=1 ; dup; x[0..5]:=15; x[10..13]:=1 ; dup; x[0..5]:=17; x[10..13]:=3 ; dup; x[0..5]:=4; x[10..13]:=4 ; dup; x[0..5]:=1; x[10..13]:=2 ; dup; x[0..5]:=7; x[10..13]:=1 ) <= hop; dup; hop; dup; hop; dup; hop; dup; hop; dup; hop

// [Orange]: Canberra1 -> Melbourne1 -> Adelaide1 -> Adelaide2
assert (x[0..5]~3; x[10..13]~0; x[13..14]~0; x[5..10]~15; x[0..5]:=16; x[10..13]:=1 ; dup; x[0..5]:=14; x[10..13]:=4 ; dup; x[0..5]:=15; x[10..13]:=2 ) <= hop; dup; hop; dup; hop
